# TIMEORA Backend Environment Configuration
# Copy this file to .env and fill in real values

# Server
PORT=5000
NODE_ENV=development

# Database - Choose ONE:
# Option A: Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/timeora_watches
# Option B: MongoDB Atlas (preferred for production)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xjmpjgh.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=your_strong_random_secret_here_min_32_chars
JWT_EXPIRE=30d

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Admin Credentials (set in DB, not here)
# ADMIN_EMAIL=admin@timeora.com
# ADMIN_PASSWORD=your_secure_admin_password

# Razorpay Payment (India)
# Get keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP) - for verification, reset, order emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=timeora@concierge.com

# Tax/GST (decimal, e.g. 0.18 = 18%)
TAX_RATE=0.18

# Shipping
FREE_SHIPPING_THRESHOLD=5000
SHIPPING_STANDARD=200
SHIPPING_EXPRESS=500

# Inventory
LOW_STOCK_THRESHOLD=5

# Upload (bytes)
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm
